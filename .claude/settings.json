{
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/ocorrencias-agentes.md)",
      "Edit(~/.claude/ocorrencias-agentes.md)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "py -3 .claude/hooks/statusline-uso.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/iniciar-sessao.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-uso.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-estado.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verificar-uso.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "executor-tarefa",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/fiscal-executor.py"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/limite-atingido.py"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
